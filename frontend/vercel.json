{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sobre-mi", "destination": "/index.html" },
    { "source": "/servicios", "destination": "/index.html" },
    { "source": "/certificados", "destination": "/index.html" },
    { "source": "/proyectos", "destination": "/index.html" },
    { "source": "/devops", "destination": "/index.html" },
    { "source": "/contacto", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
